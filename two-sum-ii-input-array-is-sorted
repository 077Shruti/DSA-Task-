class Solution {
    public int[] twoSum(int[] arr, int target) {
        int l=0;
        int r=arr.length-1;
        int[] ans=new int[2];
        for(int  i=0;i<arr.length;i++){
            if(arr[l]+arr[r]>target) r--;
            else if(arr[l]+arr[r]<target) l++;
            else{
                ans[0]=l+1;
                ans[1]=r+1;

            }
            
        }
        return ans;
    }
}
